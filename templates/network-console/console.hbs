<section class="cwnce-network-shell">
  {{#unless enabled}}
    <div class="cwnce-network-empty">
      <i class="fa-solid fa-power-off"></i>
      <h2>Network Console Disabled</h2>
      <p>Ask a GM to enable the Network Console under Configure Settings &gt; CWN Combat Enhancements, then reload the world.</p>
    </div>
  {{else}}
    {{#if notAuthorized}}
      <div class="cwnce-network-empty">
        <i class="fa-solid fa-user-lock"></i>
        <h2>No Network Shared</h2>
        <p>The active network has not been shared with your user.</p>
      </div>
    {{else}}
      {{#if isGM}}
        <header class="cwnce-network-toolbar">
          <label>
            Active Network
            <select data-network-select>
              {{#each networks}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </label>
          <button type="button" data-action="createNetwork"><i class="fa-solid fa-plus"></i> Create Network</button>
          {{#if hasNetwork}}
            <button type="button" class="danger" data-action="deleteNetwork"><i class="fa-solid fa-trash"></i> Delete</button>
          {{/if}}
        </header>
      {{/if}}

      {{#unless hasNetwork}}
        <div class="cwnce-network-empty">
          <i class="fa-solid fa-network-wired"></i>
          {{#if isGM}}
            <h2>No Networks Yet</h2>
            <p>Create a network, then drag its first node onto the canvas.</p>
            <button type="button" data-action="createNetwork"><i class="fa-solid fa-plus"></i> Create Network</button>
          {{else}}
            <h2>No Active Network</h2>
            <p>The GM has not published a network yet.</p>
          {{/if}}
        </div>
      {{else}}
        <div class="cwnce-network-layout {{#if isGM}}is-gm{{else}}is-player{{/if}}">
          {{#if isGM}}
            <aside class="cwnce-network-sidebar">
              <form class="cwnce-network-details">
                <h2><i class="fa-solid fa-server"></i> Network Architecture</h2>
                <label>Name<input type="text" name="name" value="{{network.name}}"></label>
                <label>Cyberspace Idiom<input type="text" name="idiom" value="{{network.idiom}}" placeholder="Neon temple, chrome jungle..."></label>
                <div class="form-row">
                  <label>Security Difficulty<input type="number" name="securityDifficulty" value="{{network.securityDifficulty}}" min="1"></label>
                  <label>
                    Primary Server
                    <select name="serverClass">
                      <option value="Databank" {{#if (eq network.serverClass "Databank")}}selected{{/if}}>Databank</option>
                      <option value="Alpha" {{#if (eq network.serverClass "Alpha")}}selected{{/if}}>Alpha</option>
                      <option value="Beta" {{#if (eq network.serverClass "Beta")}}selected{{/if}}>Beta</option>
                      <option value="Gamma" {{#if (eq network.serverClass "Gamma")}}selected{{/if}}>Gamma</option>
                      <option value="Delta" {{#if (eq network.serverClass "Delta")}}selected{{/if}}>Delta</option>
                      <option value="Epsilon" {{#if (eq network.serverClass "Epsilon")}}selected{{/if}}>Epsilon</option>
                    </select>
                  </label>
                </div>
                <label>
                  Alert the Network Progress
                  <select name="alertProgress">
                    <option value="0" {{#if (eq network.alertProgress 0)}}selected{{/if}}>0 of 2</option>
                    <option value="1" {{#if (eq network.alertProgress 1)}}selected{{/if}}>1 of 2</option>
                    <option value="2" {{#if (eq network.alertProgress 2)}}selected{{/if}}>ALERTED</option>
                  </select>
                </label>
                <button type="button" data-action="saveNetwork"><i class="fa-solid fa-floppy-disk"></i> Save Details</button>
              </form>

              <div class="cwnce-network-limits">
                <span><strong>{{nodeCount}}</strong>/{{serverLimits.nodes}} nodes</span>
                <span><strong>{{barrierCount}}</strong>/{{serverLimits.barriers}} barriers</span>
                <span>Demons: {{serverLimits.demons}}</span>
              </div>

              <details class="cwnce-editor-section cwnce-palette-section" open>
                <summary>Node Palette</summary>
                <div class="cwnce-node-palette">
                  {{#each nodePalette}}
                    <button
                      type="button"
                      draggable="true"
                      data-palette-node-type="{{id}}"
                      title="Drag {{label}} onto the canvas"
                      aria-label="Drag {{label}} onto the canvas"
                    >
                      <i class="{{icon}}"></i><span>{{label}}</span>
                    </button>
                  {{/each}}
                </div>
              </details>

              <details class="cwnce-editor-section">
                <summary>Nodes <span>{{nodeCount}}</span></summary>
                <div class="section-actions">
                  <button type="button" data-action="addNode" title="Add through dialog"><i class="fa-solid fa-plus"></i> Dialog</button>
                </div>
                <div class="editor-list">
                  {{#each nodeList}}
                    <article class="editor-entry {{cssClass}}">
                      <button type="button" class="entry-main" data-action="selectNode" data-node-id="{{id}}">
                        <i class="{{icon}}"></i><span>{{name}}</span>
                      </button>
                      <button type="button" data-action="toggleNodeReveal" data-node-id="{{id}}" title="Reveal or hide">
                        <i class="fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                      </button>
                      <button type="button" data-action="editNode" data-node-id="{{id}}" title="Edit in dialog"><i class="fa-solid fa-pen"></i></button>
                      <button type="button" data-action="deleteNode" data-node-id="{{id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    </article>
                  {{/each}}
                </div>
              </details>

              <details class="cwnce-editor-section">
                <summary>Connections <span>{{connectionCount}}</span></summary>
                <div class="section-actions">
                  <button type="button" data-action="addConnection"><i class="fa-solid fa-plus"></i> Add Connection</button>
                </div>
                <div class="editor-list">
                  {{#each connectionList}}
                    <article class="editor-entry {{#if revealed}}is-revealed{{else}}is-hidden{{/if}}">
                      <button type="button" class="entry-main" data-action="selectConnection" data-connection-id="{{id}}">
                        <span>{{label}}</span>
                        {{#if barrier}}<i class="fa-solid {{#if barrierLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>{{/if}}
                      </button>
                      <button type="button" data-action="toggleConnectionReveal" data-connection-id="{{id}}" title="Reveal or hide">
                        <i class="fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
                      </button>
                      <button type="button" data-action="editConnection" data-connection-id="{{id}}" title="Edit in dialog"><i class="fa-solid fa-pen"></i></button>
                      <button type="button" data-action="deleteConnection" data-connection-id="{{id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    </article>
                  {{/each}}
                </div>
              </details>
            </aside>
          {{/if}}

          <main class="cwnce-network-workspace">
            <header class="cwnce-network-statusbar">
              <div>
                <h1>{{network.name}}</h1>
                {{#if network.idiom}}<p>{{network.idiom}}</p>{{/if}}
              </div>
              <div class="network-badges">
                {{#if isGM}}<button type="button" data-action="autoArrange" title="Replace all saved node positions"><i class="fa-solid fa-wand-magic-sparkles"></i> Auto Arrange</button>{{/if}}
                <span>Security {{network.securityDifficulty}}</span>
                <span>{{network.serverClass}}</span>
                <span class="{{#if (eq network.alertProgress 2)}}alerted{{/if}}">{{alertLabel}}</span>
              </div>
            </header>

            <div class="cwnce-graph-scroll">
              <div class="cwnce-graph" style="width:{{graph.width}}px;height:{{graph.height}}px">
                <svg class="cwnce-graph-edges" viewBox="0 0 {{graph.width}} {{graph.height}}">
                  <defs>
                    <marker id="cwnce-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                      <path d="M0,0 L8,4 L0,8 Z"></path>
                    </marker>
                  </defs>
                  {{#each graph.connections}}
                    <line class="{{cssClass}}" data-connection-id="{{id}}" data-source-id="{{source}}" data-target-id="{{target}}" x1="0" y1="0" x2="0" y2="0"></line>
                    {{#if barrier}}
                      <g class="barrier-marker {{#if barrierLocked}}is-locked{{/if}}" data-connection-id="{{id}}" transform="translate(0 0)">
                        <circle r="13"></circle>
                        <text text-anchor="middle" dominant-baseline="central">{{#if barrierLocked}}X{{else}}B{{/if}}</text>
                      </g>
                    {{/if}}
                  {{/each}}
                </svg>

                {{#each graph.nodes}}
                  <button type="button" class="cwnce-graph-node {{cssClass}}" style="{{positionStyle}}" data-action="selectNode" data-node-id="{{id}}">
                    <i class="{{icon}}"></i>
                    <strong>{{name}}</strong>
                    <small>{{typeLabel}}</small>
                    <span class="node-state">{{stateLabel}}</span>
                    {{#if visibleDatafileCount}}<span class="node-badge" title="Revealed datafiles"><i class="fa-solid fa-file-code"></i> {{visibleDatafileCount}}</span>{{/if}}
                    {{#each demons}}
                      <span class="cwnce-node-demon {{#unless revealed}}is-hidden{{/unless}} {{#if isFragged}}is-fragged{{/if}}">
                        <i class="fa-solid fa-ghost"></i> {{name}}
                      </span>
                    {{/each}}
                  </button>
                {{/each}}

                {{#unless graph.nodes.length}}
                  <div class="graph-empty">{{#if isGM}}Drag a node from the palette to begin mapping this network.{{else}}No nodes have been revealed.{{/if}}</div>
                {{/unless}}
              </div>
            </div>
          </main>

          <aside class="cwnce-node-inspector">
            {{#if selectedConnection}}
              <header><i class="fa-solid fa-link"></i><div><h2>Connection</h2><p>{{selectedConnection.label}}</p></div></header>
              {{#if isGM}}
                <form class="cwnce-inspector-form" data-connection-id="{{selectedConnection.id}}">
                  <label>Source<select name="source">{{#each selectedConnection.nodeOptions}}<option value="{{id}}" {{#if sourceSelected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
                  <label>Target<select name="target">{{#each selectedConnection.nodeOptions}}<option value="{{id}}" {{#if targetSelected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
                  <label class="checkbox"><input type="checkbox" name="revealed" {{#if selectedConnection.revealed}}checked{{/if}}> Revealed</label>
                  <label class="checkbox"><input type="checkbox" name="oneWay" {{#if selectedConnection.oneWay}}checked{{/if}}> One Way</label>
                  <label class="checkbox"><input type="checkbox" name="barrier" {{#if selectedConnection.barrier}}checked{{/if}}> Barrier</label>
                  <label class="checkbox"><input type="checkbox" name="barrierLocked" {{#if selectedConnection.barrierLocked}}checked{{/if}}> Barrier Locked</label>
                  <label>Private GM Notes<textarea name="gmNotes" rows="4">{{selectedConnection.gmNotes}}</textarea></label>
                  <button type="button" data-action="saveConnectionInspector"><i class="fa-solid fa-floppy-disk"></i> Save Connection</button>
                  <button type="button" class="danger" data-action="deleteConnection" data-connection-id="{{selectedConnection.id}}"><i class="fa-solid fa-trash"></i> Delete Connection</button>
                </form>
              {{/if}}
            {{else}}
              {{#if selectedNode}}
                <header><i class="{{selectedNode.icon}}"></i><div><h2>{{selectedNode.name}}</h2><p>{{selectedNode.typeLabel}}</p></div></header>
                {{#if isGM}}
                  <div class="cwnce-inspector-actions">
                    <button type="button" data-action="toggleNodeReveal" data-node-id="{{selectedNode.id}}" title="Reveal or hide"><i class="fa-solid {{#if selectedNode.revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
                    <button type="button" data-action="connectSelectedNode" data-node-id="{{selectedNode.id}}" title="Connect selected node"><i class="fa-solid fa-link"></i></button>
                    <button type="button" data-action="duplicateNode" data-node-id="{{selectedNode.id}}" title="Duplicate"><i class="fa-solid fa-clone"></i></button>
                    <button type="button" data-action="editNodeDetails" data-node-id="{{selectedNode.id}}" title="Details and notes"><i class="fa-solid fa-note-sticky"></i></button>
                    <button type="button" class="danger" data-action="deleteNode" data-node-id="{{selectedNode.id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  <form class="cwnce-inspector-form" data-node-id="{{selectedNode.id}}">
                    <label>Name<input type="text" name="name" value="{{selectedNode.name}}"></label>
                    <label>Device Type<select name="type">{{#each nodeTypeOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label>Operational State<select name="state">{{#each nodeStateOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label class="checkbox"><input type="checkbox" name="revealed" {{#if selectedNode.revealed}}checked{{/if}}> Revealed to players</label>
                    <button type="button" data-action="saveNodeInspector"><i class="fa-solid fa-floppy-disk"></i> Save Node</button>
                  </form>

                  <section class="cwnce-structured-section">
                    <div class="section-heading"><h3>Demons</h3><button type="button" data-action="addDemon" data-node-id="{{selectedNode.id}}" title="Add Demon"><i class="fa-solid fa-plus"></i></button></div>
                    {{#each selectedNode.demons}}
                      <article class="cwnce-structured-entry demon {{#unless revealed}}is-hidden{{/unless}} {{#if isFragged}}is-fragged{{/if}} {{#if expanded}}is-expanded{{/if}}">
                        <button type="button" class="cwnce-demon-summary" data-action="toggleDemonExpanded" data-demon-id="{{id}}" aria-expanded="{{expanded}}">
                          <strong><i class="fa-solid fa-ghost"></i> {{name}}</strong>
                          <small>{{classLabel}} · {{profileLabel}} · HP {{currentHp}}/{{maxHp}} · {{#if isFragged}}FRAGGED{{else}}Active{{/if}}</small>
                        </button>
                        <div class="cwnce-demon-row-actions">
                          <button type="button" data-action="toggleDemonReveal" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}" title="Reveal or hide"><i class="fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
                          <button type="button" data-action="editDemon" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}" title="Edit"><i class="fa-solid fa-pen"></i></button>
                          <button type="button" data-action="duplicateDemon" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}" title="Duplicate"><i class="fa-solid fa-clone"></i></button>
                          <button type="button" data-action="deleteDemon" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                        </div>
                        {{#if expanded}}
                          <div class="cwnce-demon-expanded">
                            <div class="cwnce-demon-hp-controls">
                              <button type="button" data-action="adjustDemonHp" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}" data-delta="-1" title="Reduce HP by 1">−</button>
                              <input type="number" min="0" max="{{maxHp}}" value="{{currentHp}}" data-demon-hp aria-label="Current HP">
                              <button type="button" data-action="setDemonHp" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}">Set HP</button>
                              <button type="button" data-action="adjustDemonHp" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}" data-delta="1" title="Increase HP by 1">+</button>
                              <button type="button" data-action="applyDemonDamage" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}">Apply Damage</button>
                              <button type="button" data-action="restoreDemon" data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}">Restore</button>
                            </div>
                            <label class="cwnce-demon-state">State
                              <select data-demon-state data-node-id="{{../selectedNode.id}}" data-demon-id="{{id}}">
                                <option value="active" {{#unless isFragged}}selected{{/unless}}>Active</option>
                                <option value="fragged" {{#if isFragged}}selected{{/if}}>Fragged</option>
                              </select>
                            </label>
                            <ol class="cwnce-demon-commands">
                              {{#each commands}}
                                <li class="source-{{sourceType}}">
                                  <span><b>{{priority}}.</b> {{text}} <small>{{sourceType}}</small></span>
                                  {{#if executable}}
                                    <button type="button" data-action="executeDemonAction" data-node-id="{{nodeId}}" data-demon-id="{{demonId}}" data-action-key="{{actionKey}}" {{#if ../actionDisabled}}disabled{{/if}}>{{action.label}}</button>
                                  {{else}}
                                    <em>Advisory</em>
                                  {{/if}}
                                </li>
                              {{/each}}
                            </ol>
                            {{#if notes}}<p class="cwnce-demon-notes"><strong>GM:</strong> {{notes}}</p>{{/if}}
                          </div>
                        {{/if}}
                      </article>
                    {{/each}}
                  </section>

                  <section class="cwnce-structured-section">
                    <div class="section-heading"><h3>Datafiles</h3><button type="button" data-action="addDatafile" data-node-id="{{selectedNode.id}}" title="Add datafile"><i class="fa-solid fa-plus"></i></button></div>
                    {{#each selectedNode.datafiles}}
                      <article class="cwnce-structured-entry {{#unless revealed}}is-hidden{{/unless}}">
                        <div><strong>{{name}}</strong><small>{{value}} credits{{#if copied}} · copied{{/if}}</small></div>
                        <button type="button" data-action="toggleDatafileReveal" data-node-id="{{../selectedNode.id}}" data-datafile-id="{{id}}" title="Reveal or hide"><i class="fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
                        <button type="button" data-action="editDatafile" data-node-id="{{../selectedNode.id}}" data-datafile-id="{{id}}" title="Edit"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" data-action="deleteDatafile" data-node-id="{{../selectedNode.id}}" data-datafile-id="{{id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                      </article>
                    {{/each}}
                  </section>

                  <section class="cwnce-structured-section">
                    <div class="section-heading"><h3>Watchdogs</h3><button type="button" data-action="addWatchdog" data-node-id="{{selectedNode.id}}" title="Add Watchdog"><i class="fa-solid fa-plus"></i></button></div>
                    {{#each selectedNode.watchdogs}}
                      <article class="cwnce-structured-entry {{#unless revealed}}is-hidden{{/unless}}">
                        <div><strong>{{name}}</strong></div>
                        <button type="button" data-action="toggleWatchdogReveal" data-node-id="{{../selectedNode.id}}" data-watchdog-id="{{id}}" title="Reveal or hide"><i class="fa-solid {{#if revealed}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></button>
                        <button type="button" data-action="editWatchdog" data-node-id="{{../selectedNode.id}}" data-watchdog-id="{{id}}" title="Edit"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" data-action="deleteWatchdog" data-node-id="{{../selectedNode.id}}" data-watchdog-id="{{id}}" title="Delete"><i class="fa-solid fa-trash"></i></button>
                      </article>
                    {{/each}}
                  </section>
                {{else}}
                  <dl>
                    <dt>State</dt><dd>{{selectedNode.stateLabel}}</dd>
                    {{#if selectedNode.description}}<dt>Description</dt><dd>{{selectedNode.description}}</dd>{{/if}}
                    {{#each selectedNode.datafiles}}
                      <dt><i class="fa-solid fa-file-code"></i> Datafile: {{name}}</dt>
                      <dd>{{description}}<br>Value: {{value}} credits{{#if copied}} · Copied{{/if}}</dd>
                    {{/each}}
                    {{#each selectedNode.demons}}<dt><i class="fa-solid fa-ghost"></i> Demon</dt><dd>{{name}}</dd>{{/each}}
                    {{#each selectedNode.watchdogs}}<dt><i class="fa-solid fa-user-secret"></i> Watchdog</dt><dd>{{name}}</dd>{{/each}}
                  </dl>
                  <div class="cwnce-action-grid">
                    {{#each playerActions}}
                      <button type="button" data-action="requestAction" data-request-id="{{id}}">
                        <i class="{{icon}}"></i><span>{{label}}</span><small>{{economy}}</small>
                      </button>
                    {{/each}}
                  </div>
                  <p class="prototype-note">Requests notify the GM. Run a Program uses prepared Verbs and Subjects. This console does not roll checks, spend Access, execute programs, or change Alert automatically.</p>
                {{/if}}
              {{else}}
                <div class="cwnce-network-empty compact"><i class="fa-solid fa-arrow-pointer"></i><p>Select a node or connection to inspect it.</p></div>
              {{/if}}
            {{/if}}
          </aside>
        </div>
      {{/unless}}
    {{/if}}
  {{/unless}}
</section>
